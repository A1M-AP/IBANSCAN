# Canonical address. Use your HTTPS production domain when deployed.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public support address displayed on Contact; no email is invented if empty.
NEXT_PUBLIC_CONTACT_EMAIL=
# Operator identity shown on Contact, footer and legal pages. Legal pages stay marked
# as drafts until NAME, ADDRESS and CONTACT_EMAIL are all set. Public values only.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_ADDRESS=
# Optional: VAT number (Partita IVA), certified email (PEC), hosting provider name.
NEXT_PUBLIC_OPERATOR_VAT_ID=
NEXT_PUBLIC_OPERATOR_PEC=
NEXT_PUBLIC_HOSTING_PROVIDER=
# Optional AdSense display units. Public identifiers, never a private API key.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_HOME_SLOT=
NEXT_PUBLIC_ADSENSE_TOOL_SLOT=
NEXT_PUBLIC_ADSENSE_RESOURCE_SLOT=
# URL of your Google-certified CMP script, supplied by Privacy & messaging.
# Only Google's fundingchoicesmessages.google.com HTTPS origin is accepted.
NEXT_PUBLIC_GOOGLE_CMP_URL=
# No Gemini keys, API keys or database are required by this simplified release.
