# Public canonical URL and same-origin protection. Use HTTPS in production.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional genuine AI. Keys are server-only; never use NEXT_PUBLIC_ for a key.
# Choose google or openai-compatible. Without AI_PROVIDER, existing installations
# keep the OpenAI-compatible provider. No AI calls run without a key AND model.
AI_PROVIDER=google
# Google: create a restricted Gemini API key at https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
# Check current model availability for your project before deploying.
GOOGLE_AI_MODEL=gemini-3.5-flash-lite
# Used only when AI_PROVIDER=openai-compatible. The endpoint must support strict
# JSON-schema structured outputs. Select a model from your provider's catalog.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Cross-user spending guard: maximum AI requests within a 24-hour window.
AI_GLOBAL_DAILY_LIMIT=200

# API provisioned by operator; keys are never bundled in browser code.
# JSON array of {"id":"customer-id","hash":"64-character-sha256-hex","plan":"business"}.
# Generate a random key and hash using the deployment guide. Never store the key here.
IBANSCAN_API_KEY_HASHES=

# Required in production: at least 32 random characters for HMAC anonymization.
RATE_LIMIT_HASH_SECRET=
# Distributed Redis REST (e.g. Upstash): both values required for multi-instance.
RATE_LIMIT_REDIS_REST_URL=
RATE_LIMIT_REDIS_REST_TOKEN=
# Set true ONLY for one persistent Node process. Never for serverless or replicas.
RATE_LIMIT_ALLOW_SINGLE_INSTANCE=false
# Set only to an IP header your trusted ingress overwrites with ONE bare IP.
# No comma-separated X-Forwarded-For parsing. If unset, anonymous users share limits.
TRUSTED_IP_HEADER=

# Reserved persistence/billing architecture; not needed for core utilities.
# No database connection or payment collection occurs in this first release.
DATABASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional operator contact shown by the application, if configured.
NEXT_PUBLIC_CONTACT_EMAIL=
